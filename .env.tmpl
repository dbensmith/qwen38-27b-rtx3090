# Template for .env (gitignored, generated via: op inject -i .env.tmpl -o .env)
# Same 1Password item agent-selfhosted uses for LLAMA_SERVER_API_KEY (D-02) — one
# shared key across both local model servers, not a new item.
VLLM_API_KEY=op://ops-dotfiles/qbdcgbhl4olpro6wrx4x4cg5qq/credential

# WSL2 knobs (D-03). start_qwen.sh already auto-detects WSL2 and defaults
# PYTORCH_CUDA_ALLOC_CONF to False, but pin both explicitly here so they're
# visible/documented rather than relying on runtime auto-detection.
GPU_UTIL=0.93
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False

# Single-user daily-driver config (D-04) — README's documented "fastest
# single-user decode" recipe. batch/start_qwen.sh does not read SPEC,
# DFLASH_TOKENS, or VLLM_WSL2_ENABLE_PIN_MEMORY (single-user-only knobs), but
# it DOES read PREFIX_CACHE, so batch also picks up prefix caching from this
# shared .env — accepted per D-05, since batch/start_qwen.sh's own header
# comment calls PREFIX_CACHE=1 throughput-neutral-or-positive and it never
# blocks startup.
SPEC=dflash2
DFLASH_TOKENS=15
PREFIX_CACHE=1
VLLM_WSL2_ENABLE_PIN_MEMORY=1
